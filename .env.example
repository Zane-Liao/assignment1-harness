# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# Optional overrides
# CS329Z_GRADING_MODEL=gpt-6-luna
# CS329Z_DEV_MODEL=gpt-6-luna  # set a different model here to iterate on it with CS329Z_MODEL=dev
# CS329Z_MODEL=dev            # which role the live tests use: "grading" (default) or "dev"
# CS329Z_REASONING_EFFORT=low # reasoning effort for models that accept it
# CS329Z_BUDGET_USD=25        # the LM wrapper refuses new calls once total spend reaches this
# CS329Z_EVAL_SLICE=5         # run live tests on the first N items only
